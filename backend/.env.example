# Copy this file to backend/.env and fill in YOUR values. Never commit .env.

# --- Required ---
# Atlas example: mongodb+srv://<db-user>:<url-encoded-password>@<cluster-host>/campus-ev?retryWrites=true&w=majority
MONGODB_URI=my key
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=my key

# --- Server ---
PORT=3000
NODE_ENV=development
# Public URL of the website (used in emails and as an allowed origin)
APP_URL=http://localhost:3000
# Extra browser origins allowed to call the API, comma separated (e.g. your Vercel URL)
CORS_ORIGINS=
DNS_SERVERS=8.8.8.8,1.1.1.1
# --- First admin account (created on startup if the email does not exist yet) ---
ADMIN_EMAIL=admin@campus.local
ADMIN_PASSWORD=raju12345

# --- Development only: demo drivers/student (ignored when NODE_ENV=production) ---
SEED_DEMO=false
SEED_DEMO_PASSWORD=Password123

# --- Email (optional; without SMTP, links are printed to the console in development) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vasanthkumaralanka@gmail.com
SMTP_PASS=nvou ksah kgdd lgta
MAIL_FROM=Campus EV <vasanthkumaralanka@gmail.com>
# true = users must verify email before login (defaults to true when SMTP_HOST is set)
EMAIL_VERIFICATION_REQUIRED=false

# --- Dispatch / pricing (optional, defaults shown) ---
DISPATCH_RADIUS_KM=10
OFFER_TIMEOUT_SECONDS=60
MAX_WAIT_MINUTES=15
LOCATION_MAX_AGE_SECONDS=900
# Only allow rides inside the campus: "lat,lng" and radius
SERVICE_AREA_CENTER=
SERVICE_AREA_RADIUS_KM=
# Road routing (OSRM-compatible). Empty = straight-line estimate x ROAD_FACTOR
ROUTING_URL=
FARE_AUTO_BASE=20
FARE_AUTO_PER_KM=10
FARE_AUTO_MIN=30
FARE_BUS_BASE=5
FARE_BUS_PER_KM=2
FARE_BUS_MIN=10
